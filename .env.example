# --- Discord ---
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=
# Optional: role that can be mentioned instead of the bot user
DM_ROLE_ID=

# Channels. Players and their private channels live in the database
# (campaign_players.private_channel_id, docs/DECISIONS.md D-020).
MAIN_ADVENTURE_CHANNEL_ID=
DM_TEST_CHANNEL_ID=

# --- OpenAI ---
OPENAI_API_KEY=replace_me
# Turns, maps and image prompts (D-026)
OPENAI_MODEL=gpt-5.4-mini
# Saves decide who knows what: a stronger model (defaults to OPENAI_MODEL)
CHECKPOINT_MODEL=gpt-5.4
MAX_OUTPUT_TOKENS=1200
# Output cap for each checkpoint save call; a save that doesn't fit saves nothing
CHECKPOINT_MAX_OUTPUT_TOKENS=8000
# History per channel since the last save, newest first, at most this many characters
HISTORY_MAX_CHARS=18000

# --- Cost (D-026): estimate logged per call; warning in #dm-testing at 80% and 100%, play never stops ---
MONTHLY_BUDGET_USD=15
# Estimated cost per generated image
IMAGE_COST_USD=0.02

# --- Scene images (docs/DECISIONS.md D-008) ---
# Image model available on your OpenAI account (gpt-image family).
IMAGE_MODEL=gpt-image-1-mini
IMAGE_QUALITY=medium
IMAGE_SIZE=1536x1024
# Max images per server per rolling 24 hours (arrivals + /image together)
IMAGE_DAILY_LIMIT=10
# House style prepended to every picture prompt
IMAGE_STYLE=Painterly dark-fantasy illustration, muted earthy colours, atmospheric lighting, no text or lettering.

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
